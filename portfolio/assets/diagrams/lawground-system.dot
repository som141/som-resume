digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.3", ranksep="0.6", fontname="Noto Sans CJK KR"];
  node [shape=box, style="filled", fillcolor="#ffffff", color="#3f4650", fontcolor="#20242a", fontname="Noto Sans CJK KR", fontsize=9.5, margin="0.14,0.09"];
  edge [color="#6a717b", fontname="Noto Sans CJK KR", fontsize=8.5, arrowsize=0.7];
  browser [label="Web 사용자"];
  spring [label="Spring API\n회원 · 문제 · 라이브러리\n분석 실행/조회"];
  job [label="Job worker\nlease · fencing · checkpoint"];
  pg [label="PostgreSQL + pgvector\n업무 데이터 · FTS · vector", shape=cylinder, fillcolor="#f3f4f5"];
  mq [label="RabbitMQ\n작업 신호", shape=cylinder, fillcolor="#f3f4f5"];
  model [label="Python AI HTTP 계약\nembed · rerank · verify", fillcolor="#f4eee5"];
  browser -> spring;
  spring -> pg;
  spring -> mq [label="run 생성 후 발행"];
  mq -> job;
  job -> pg [label="claim/상태/결과"];
  job -> model [label="LIVE 모드에서 호출"];
  model -> job;
  spring -> browser [label="202 + run 조회"];
}
