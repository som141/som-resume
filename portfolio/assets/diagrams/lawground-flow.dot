digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.2, nodesep=0.28];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=9.5, color="#c7d5e7", fillcolor="#f7f9fc", fontcolor="#172033", margin="0.11,0.08"];
  edge [color="#3b6bb1", penwidth=1.5, arrowsize=0.58];
  a [label="Google\n로그인"];
  b [label="문제 · 선지 · 정답\n기준일 입력"];
