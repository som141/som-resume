digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.25", ranksep="0.55", fontname="Noto Sans CJK KR"];
  node [shape=box, style="filled", fillcolor="#ffffff", color="#3f4650", fontcolor="#20242a", fontname="Noto Sans CJK KR", fontsize=9.5, margin="0.14,0.09"];
  edge [color="#6a717b", fontname="Noto Sans CJK KR", fontsize=8.5, arrowsize=0.7];
  cmd [label="/play"];
  prep [label="Gateway\ndefer + pending 저장"];
  consume [label="Audio Node\n명령 소비"];
  load [label="검색 · track load"];
  start [label="player 시작"];
  sound [label="Discord 음성 송신", fillcolor="#f4eee5"];
  fail [label="TrackException / stuck\n실패 분류"];
  reply [label="요청자의 원 응답 편집"];
  next [label="실패 곡 정리\n다음 곡 진행"];
  cmd -> prep -> consume -> load -> start -> sound;
  load -> reply [label="접수/검색 결과"];
  start -> fail [label="403 · decoder · 무음 정체"];
  fail -> reply [label="late failure"];
  fail -> next;
}
