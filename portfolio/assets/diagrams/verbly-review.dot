digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.2, nodesep=0.36];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=10, color="#c7d5e7", fillcolor="#f7f9fc", fontcolor="#172033", margin="0.13,0.09"];
  edge [fontname="Noto Sans CJK KR", fontsize=8, color="#3b6bb1", fontcolor="#315987", penwidth=1.5, arrowsize=0.6];
  l [label="LibraryItem\n학습 표현"];
  t [label="ReviewTask\n대기 · 진행 · 완료"];
  s [label="ReviewSession\n순서 · 힌트 · 상태"];
  q [label="ReviewQuestion\n빈칸 · 객관식"];
  a [label="ReviewAnswer\n답안 · 정답 여부 · 시도", fillcolor="#e8f4ef", color="#7cb59d"];
  l -> t [label=" 복습 대상 "];
  t -> s [label=" 세션 배정 "];
  s -> q [label=" 문제 생성 "];
  q -> a [label=" 답안 저장 "];
}
