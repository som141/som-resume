digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.35", ranksep="0.65", fontname="Noto Sans CJK KR"];
  node [shape=box, style="filled", fillcolor="#ffffff", color="#3f4650", fontcolor="#20242a", fontname="Noto Sans CJK KR", fontsize=10, margin="0.15,0.10"];
  edge [color="#6a717b", fontcolor="#4d535c", fontname="Noto Sans CJK KR", fontsize=9, arrowsize=0.7];
  user [label="Discord 사용자", fillcolor="#f4eee5"];
  gateway [label="Gateway\n명령 등록 · 권한 검사\n응답 위치 보관"];
  rabbit [label="RabbitMQ\n명령 / 결과", shape=cylinder, fillcolor="#f3f4f5"];
  audio [label="Audio Node\n길드별 player · queue\nDiscord 음성 송신"];
  stock [label="Stock Node\n시세 · 계좌 · 거래\n시즌 · 순위"];
  redis [label="Redis\npending 응답\n음악 상태 · 캐시", shape=cylinder, fillcolor="#f3f4f5"];
  pg [label="PostgreSQL\n계좌 · 포지션 · 원장\n스냅샷 · watchlist", shape=cylinder, fillcolor="#f3f4f5"];
  youtube [label="YouTube / cipher"];
  finnhub [label="Finnhub"];
  user -> gateway [label="Slash command"];
  gateway -> rabbit [label="commandId + responseTargetNode"];
  rabbit -> audio [label="music command"];
  rabbit -> stock [label="stock command"];
  audio -> rabbit [label="result / late failure"];
  stock -> rabbit [label="result"];
  rabbit -> gateway [label="gateway별 result"];
  gateway -> user [label="deferred reply 편집"];
  gateway -> redis;
  audio -> redis;
  stock -> redis;
  stock -> pg;
  audio -> youtube;
  stock -> finnhub;
  audio -> user [label="voice packet", constraint=false];
}
