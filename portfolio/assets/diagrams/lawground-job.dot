digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.2, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=9.5, color="#c7d5e7", fillcolor="#f7f9fc", fontcolor="#172033", margin="0.12,0.08"];
  edge [fontname="Noto Sans CJK KR", fontsize=8, color="#3b6bb1", fontcolor="#315987", penwidth=1.5, arrowsize=0.6];
  u [label="사용자\n분석 요청"];
  b [label="DB\n입력 snapshot · 멱등 키", shape=cylinder, fillcolor="#ffffff"];
  q [label="RabbitMQ", shape=cylinder, fillcolor="#ffffff"];
  w [label="Worker\n단계별 처리"];
  cp [label="DB\ncheckpoint · lease", shape=cylinder, fillcolor="#ffffff"];
  r [label="결과 저장", fillcolor="#e8f4ef", color="#7cb59d"];
  v [label="화면\n실행 ID로 상태 조회"];
  u -> b -> q -> w -> cp -> r;
  b -> v [label=" 실행 ID "];
  cp -> w [label=" 재개 "];
  r -> v;
}
